# --- Build output -----------------------------------------------------------
# PlatformIO: toolchains, library sources and firmware images
.pio/
# Node
node_modules/
npm-debug.log*
# The preview harness renders every screen to a PNG contact sheet
esp32/tools/preview/out/

# --- Editor and tooling -----------------------------------------------------
# Generated by the PlatformIO IDE extension: absolute paths for one machine only
.vscode/
*.code-workspace
# Claude Code's per-machine settings (a shared .claude/settings.json is fine)
.claude/settings.local.json

# --- macOS ------------------------------------------------------------------
.DS_Store
**/.DS_Store

# --- Local reference material ------------------------------------------------
# The panel datasheet is GoodDisplay's document, not ours to redistribute.
# Keep your own copy here; docs/reference/README.md says where to get it.
docs/reference/*.pdf
# Page renders of it, produced locally when reading the tables
*.ppm
*.pgm

# Original scratch note: describes hardware that was never built, and says so.
SpecsMini.md
